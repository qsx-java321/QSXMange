<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.qsx</groupId>
    <artifactId>qsx-manager-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>qsx-manager-parent</name>
    <description>QSX 后台管理系统 - 单体多模块父工程</description>

    <modules>
        <module>qsx-common</module>
        <module>qsx-security</module>
        <module>qsx-framework</module>
        <module>qsx-module-system</module>
        <module>qsx-admin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <easyexcel.version>4.0.3</easyexcel.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块：依赖链 common → security → framework → module-system → admin -->
            <dependency>
                <groupId>com.qsx</groupId>
                <artifactId>qsx-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.qsx</groupId>
                <artifactId>qsx-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.qsx</groupId>
                <artifactId>qsx-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.qsx</groupId>
                <artifactId>qsx-module-system</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方：版本统一在此收敛 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 分页插件依赖（3.5.9+ 需单独引入） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- Excel 导入导出（EasyExcel，SAX 流式读写，POI 5.2.5） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>